# ================================================================
# KONFIGURASI BOT KEUANGAN TELEGRAM
# ================================================================

# [WAJIB] Token Bot Telegram yang didapatkan dari @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# [OPSIONAL] Path database SQLite lokal (default: database/finance.db)
DATABASE_PATH=database/finance.db

# [OPSIONAL] Integrasi Google Sheets
# Biarkan kosong jika ingin memakai database SQLite & ekspor CSV saja
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
